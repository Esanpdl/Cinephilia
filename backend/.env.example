# Copy to .env. Generate a unique secret; never commit .env.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Supabase Dashboard > Connect > Session pooler (5432).
# Copy the actual URI and percent-encode reserved characters in the password.
DATABASE_URL=
DATABASE_SSL_MODE=require
# Used by production workers; DEBUG/runserver always closes after each request.
DATABASE_CONN_MAX_AGE=60
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_TIME_ZONE=Asia/Kathmandu

# TMDB account > Settings > API > API Read Access Token.
TMDB_READ_ACCESS_TOKEN=
# Alternatively, use a v3 API key instead of a Read Access Token.
TMDB_API_KEY=
TMDB_LANGUAGE=en-US
TMDB_MIN_VOTES=200
# Approved policy: no rating cutoff; order eligible movies by rating descending.
TMDB_MIN_RATING=0
TMDB_CACHE_TTL=86400
TMDB_REQUESTS_PER_SECOND=8

# Phase 5: relative weights are normalized; popularity must stay positive.
HYBRID_CONTENT_WEIGHT=0.45
HYBRID_COLLABORATIVE_WEIGHT=0.40
HYBRID_POPULARITY_WEIGHT=0.15
HYBRID_MIN_LIKED_RATING=7
HYBRID_MAX_CONTENT_SEEDS=20
HYBRID_CATALOG_CACHE_SECONDS=86400
FRONTEND_BASE_URL=http://127.0.0.1:5173
DEFAULT_FROM_EMAIL=Cinephilia <noreply@cinephilia.local>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Bounded per-process database pool; multiply max size by deployment workers.
DATABASE_POOL_ENABLED=true
DATABASE_POOL_MAX_SIZE=4
